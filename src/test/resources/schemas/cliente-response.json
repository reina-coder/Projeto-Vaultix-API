{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "nome", "email", "cpf"],
  "properties": {
    "id": { "type": "integer" },
    "nome": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "cpf": { "type": "string" },
    "telefone": { "type": ["string", "null"] },
    "dtCadastro": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}

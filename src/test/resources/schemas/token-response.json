{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["token", "tokenType", "expiresInSeconds"],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 10
    },
    "tokenType": {
      "type": "string",
      "enum": ["Bearer"]
    },
    "expiresInSeconds": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["content", "totalElements", "totalPages", "size", "number"],
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nome", "email", "cpf"],
        "properties": {
          "id": { "type": "integer" },
          "nome": { "type": "string" },
          "email": { "type": "string" },
          "cpf": { "type": "string" },
          "telefone": { "type": ["string", "null"] },
          "dtCadastro": { "type": ["string", "null"] }
        }
      }
    },
    "totalElements": { "type": "integer" },
    "totalPages": { "type": "integer" },
    "size": { "type": "integer" },
    "number": { "type": "integer" }
  }
}
